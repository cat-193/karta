<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>joombig thumbnail navigator with arrows</name>
	<author>joombig.com</author>
	<creationDate>Mach 2014</creationDate>
	<copyright>Copyright (C) 2013 joombig.com. All rights reserved.</copyright>
	<license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>support@joombig.com</authorEmail>
	<authorUrl>www.joombig.com</authorUrl>
	<version>1.0</version>
	<description>MODULE_DESC</description>
	 <languages>
    <language tag="en-GB">language/en-GB.mod_joombig_thumbnail_navigator_with_arrows.ini</language>
  </languages>
	<files>
		<filename module="mod_joombig_thumbnail_navigator_with_arrows">mod_joombig_thumbnail_navigator_with_arrows.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<folder>elements/</folder>
		<folder>assets/</folder>
		<folder>tmpl/</folder>
		<folder>language/</folder>
	</files>
	<config>
		<fields name="params" addfieldpath="/modules/mod_joombig_thumbnail_navigator_with_arrows/elements">
			<fieldset name="basic">
				<field type="loader" />
				<field name="moduleclass_sfx" type="text" default="" label="Module Class Suffix" description="A suffix to be applied to the css class of the module (table.moduletable), this allows individual module styling" />
				<field name="enable_jQuery" type="radio" default="1" label="Enable/Disable jQuery" description="select Enable/Disable">
					<option value="1">Enable</option>
					<option value="0">Disable</option>
				</field>
				<field name="path" type="foldertree" default="" directory="images" filter="" label="Image large directory" description="Select a image directory" />
				<field name="width_module" type="text" default="900" label="Width of module" description="Width without px" />
				<field name="height_module" type="text" default="500" label="Height of module" description="Height without px" />
				<field name="left_module" type="text" default="0" label="Left of module" description="Left without px" />
				<field name="width_thumb" type="text" default="72" label="Width of thumb" description="Width without px" />
				<field name="height_thumb" type="text" default="72" label="Height of thumb" description="Height without px" />
				<field name="auto_play" type="list" default="1" label="Autoplay" description="Select yes/no">
					<option value="1">Yes</option>
					<option value="0">No</option>
				</field>
				<field name="play_speed" type="text" default="4000" label="Play speed" description="Play speed" />
				<field name="backgrond_color" type="hotcolor" default="#ffffff" label="Background color" description="Color of Background" />
				<field name="boder_thumb" type="list" default="1" label="Enable/Disable boder of thumb" description="select Enable/Disable">
					<option value="1">Enable</option>
					<option value="0">Disable</option>
				</field>
			</fieldset>
			
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="Caching" description="Select whether to cache the content of this module">
					<option value="1">Use global</option>
					<option value="0">No caching</option>
				</field>
				<field name="cache_time" type="text" default="900" label="Cache Time" description="The time before the module is recached" />
			</fieldset>			
		</fields>
	</config>
</extension>